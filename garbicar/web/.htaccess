# Garbicar · ajustes para el hosting de IONOS (Apache). Si algo falla, se puede borrar este archivo.

AddType image/webp .webp
AddType image/avif .avif
AddType video/mp4 .mp4
AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Las páginas antiguas de WordPress redirigen a las nuevas
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^aviso-legal/?$ aviso-legal.html [R=301,L]
  RewriteRule ^politica-de-privacidad/?$ politica-privacidad.html [R=301,L]
  RewriteRule ^condiciones-generales-de-contratacion/?$ condiciones-contratacion.html [R=301,L]
  RewriteRule ^servicios/?$ index.html#servicios [R=301,NE,L]
  RewriteRule ^contacto/?$ index.html#contacto [R=301,NE,L]
</IfModule>
